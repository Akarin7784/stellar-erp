# 复制为 .env 后按需修改（.env 已被 git 忽略，切勿提交真实凭据）
# docker-compose.yml 与后端 dev profile 共用以下变量
DB_URL=jdbc:postgresql://localhost:5432/stellar_erp
DB_USER=erp
DB_PASSWORD=erp_dev_password
RABBITMQ_PASSWORD=erp_dev_password
# 生产环境：SPRING_PROFILES_ACTIVE=prod，且必须提供 DB_URL / DB_USER / DB_PASSWORD
# SPRING_PROFILES_ACTIVE=prod

# Redis（Sa-Token token 存储）；prod 必填 REDIS_HOST
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
